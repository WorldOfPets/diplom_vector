Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let's Encrypt HTTP-01 must reach the challenge files directly.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Defense in depth: never serve databases, logs or backups even if mod_rewrite is off.
<FilesMatch "\.(sqlite|sqlite3|db|log|bak|old|tar|gz|zip)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(database|storage|tests|content|vendor)/
